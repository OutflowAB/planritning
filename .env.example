# Copy to .env.local (hosted) or .env.docker.local (local Docker Supabase) and fill in.
# Never commit real values.

# Supabase: project URL and the secret (service role) key. The browser never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies. Generate with: openssl rand -hex 32. Rotating it signs everyone out.
AUTH_SECRET=

# AI redraw (optional; without a key the algorithm engine is used).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
OPENAI_IMAGE_RETRY_MODEL=
IMAGE_ENGINE=
STYLE_DEVIATION_THRESHOLD=
STYLE_REVIEW_ENABLED=
STYLE_REVIEW_MODEL=
STYLE_REVIEW_TRIGGER=

# Price per finished plan in kronor (default 50) and the firm-wide monthly AI cap (default 1000).
PLAN_PRICE_SEK=
AI_MONTHLY_CAP=

# Protects the daily retention job (/api/cron/purge-uploads). Vercel sends it automatically.
CRON_SECRET=
